VITE_SUPABASE_URL=https://your-project.supabase.co
# From Dashboard → API Keys → Publishable and secret API keys (starts with sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Optional: slug of the team row that holds the org-wide weekly priority list (default: teaming)
# VITE_ORG_TEAM_SLUG=teaming
# Collector only (never put this in Vite). Dashboard → API Keys → service role / secret.
# SEO_GEO_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
